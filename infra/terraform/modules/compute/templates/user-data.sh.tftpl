#!/usr/bin/env bash
set -Eeuo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  docker.io \
  unzip
rm -rf /var/lib/apt/lists/*

temporary_aws_cli="$(mktemp -d)"
trap 'rm -rf "$temporary_aws_cli"' EXIT
curl --fail --location --silent --show-error \
  'https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip' \
  --output "$temporary_aws_cli/awscliv2.zip"
unzip -q "$temporary_aws_cli/awscliv2.zip" -d "$temporary_aws_cli"
"$temporary_aws_cli/aws/install" --update
rm -rf "$temporary_aws_cli"
trap - EXIT

systemctl enable --now docker
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service \
  || systemctl enable --now amazon-ssm-agent.service

install -d -m 0755 /usr/local/lib/docker/cli-plugins
curl --fail --location --silent --show-error \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64" \
  --output /usr/local/lib/docker/cli-plugins/docker-compose
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose

if ! swapon --show | grep -q /swapfile; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
  chmod 0600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  printf '/swapfile none swap sw 0 0\n' >> /etc/fstab
fi

install -d -m 0750 /opt/mothoq
printf '%s' '${compose_file_base64}' | base64 --decode > /opt/mothoq/compose.yaml
chmod 0640 /opt/mothoq/compose.yaml

printf '%s' '${deploy_script_base64}' | base64 --decode > /usr/local/bin/mothoq-deploy
chmod 0750 /usr/local/bin/mothoq-deploy

cat > /etc/update-motd.d/50-mothoq <<'MESSAGE'
#!/usr/bin/env bash
Mothoq host is managed by Terraform.
Deploy after pushing images and creating the production SSM parameter:
  sudo mothoq-deploy
MESSAGE
chmod 0755 /etc/update-motd.d/50-mothoq
