#!/usr/bin/env bash
set -Eeuo pipefail

cd /opt/mothoq
umask 077

temporary_environment="$(mktemp /opt/mothoq/.env.production.XXXXXX)"
trap 'rm -f "$temporary_environment"' EXIT

aws ssm get-parameter \
  --name '${parameter_name}' \
  --with-decryption \
  --region '${aws_region}' \
  --query 'Parameter.Value' \
  --output text > "$temporary_environment"

mv "$temporary_environment" .env.production
trap - EXIT

aws ecr get-login-password --region '${aws_region}' \
  | docker login --username AWS --password-stdin '${registry_host}'
trap 'docker logout "${registry_host}" >/dev/null 2>&1 || true' EXIT

docker compose --env-file .env.production pull
docker compose --env-file .env.production run --rm app php artisan migrate --force
docker compose --env-file .env.production up --detach --remove-orphans
docker image prune --force

curl --fail --silent --show-error --retry 12 --retry-delay 5 --retry-all-errors http://127.0.0.1/up
printf '\nMothoq deployment completed successfully.\n'
