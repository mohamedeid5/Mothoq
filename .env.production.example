APP_NAME=Mothoq
APP_ENV=production
APP_KEY=base64:replace-with-a-generated-production-key
APP_DEBUG=false
APP_URL=http://replace-with-ec2-public-address

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mothoq
DB_USERNAME=mothoq
DB_PASSWORD=replace-with-a-strong-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-password

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local

MAIL_MAILER=log

APP_IMAGE=mothoq-app:prod
NGINX_IMAGE=mothoq-nginx:prod
IMAGE_TAG=replace-with-an-immutable-release-tag
HTTP_PORT=80
